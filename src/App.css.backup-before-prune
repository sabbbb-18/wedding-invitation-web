  border: 1px solid rgba(153, 100, 27, 0.2);
}

.intro-ornate-wrap {
  position: relative;
  padding: 28px 20px 22px;
}

.intro-ornate-shell {
  position: relative;
  border-radius: 44% 56% 50% 50% / 36% 36% 64% 64%;
  background:
    radial-gradient(circle at 8% 50%, #c84a37 0 14px, transparent 15px) 0 6px/28px 28px repeat-y,
    radial-gradient(circle at 92% 50%, #c84a37 0 14px, transparent 15px) 100% 6px/28px 28px repeat-y,
    radial-gradient(circle at 50% 8%, #c84a37 0 14px, transparent 15px) 6px 0/28px 28px repeat-x,
    radial-gradient(circle at 50% 92%, #c84a37 0 14px, transparent 15px) 6px 100%/28px 28px repeat-x,
