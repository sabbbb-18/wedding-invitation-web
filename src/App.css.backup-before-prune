/* ================= FONTS + BASE ================ */
:root {
  --gold: rgba(255, 230, 180, 1)
}

body {
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, "Helvetica Neue", Arial, sans-serif;
  background: #060606;
  color: #fff
}

/* small helpers */
.font-inter {
  font-family: Inter, system-ui, -apple-system, Segoe UI, Roboto, Arial
}

.text-glow {
  text-shadow: 0 10px 40px rgba(255, 215, 160, 0.06), 0 2px 6px rgba(0, 0, 0, 0.6)
}

.shadow-glow {
  box-shadow: 0 12px 40px rgba(255, 200, 120, 0.06), 0 6px 16px rgba(0, 0, 0, 0.6)
}

/* ========== BOHEK / BOKEH ========== */
.bokeh-wrap {
  position: absolute;
  inset: 0;
  overflow: hidden;
  z-index: 0;
  pointer-events: none
}

.bokeh {
  position: absolute;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18), rgba(255, 255, 255, 0.01));
  filter: blur(28px);
  opacity: 0.06
}

.bokeh.b1 {
  width: 380px;
  height: 380px;
  left: 2%;
  top: 6%;
  opacity: 0.12
}

.bokeh.b2 {
  width: 220px;
  height: 220px;
  right: 6%;
  top: 14%;
  opacity: 0.08;
  animation: bob 10s ease-in-out infinite
}

.bokeh.b3 {
  width: 180px;
  height: 180px;
  left: 44%;
  top: 56%;
  opacity: 0.06
}

.bokeh.b4 {
  width: 300px;
  height: 300px;
  right: 30%;
  bottom: 8%;
  opacity: 0.04;
  animation: bob 12s ease-in-out infinite
}

.bokeh.b5 {
  width: 120px;
  height: 120px;
  left: 22%;
  bottom: 20%;
  opacity: 0.03
}

@keyframes bob {
  0% {
    transform: translateY(0)
  }

  50% {
    transform: translateY(-12px)
  }

  100% {
    transform: translateY(0)
  }
}

