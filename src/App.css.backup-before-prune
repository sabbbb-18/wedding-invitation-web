}

/* =========================
   THEME 13 OVERRIDES
   ========================= */
.theme13 {
  --t13-paper: #f6f1e8;
  --t13-paper-dark: #efe7db;
  --t13-ink: #3a2e22;
  --t13-red: #8f2a2a;
  --t13-red-dark: #6e1f1f;
  --t13-gold: #c9a45b;
  --t13-tape: #e1d7c7;
  position: relative;
  min-height: 100vh;
  background: #f3eee4;
  color: var(--t13-ink);
  font-family: "Special Elite", "Times New Roman", serif;
  overflow: hidden;
}

.scroll-react {
  opacity: 0;
  transform: translateX(44px);
  transition: opacity 0.85s ease, transform 0.85s ease;
  will-change: opacity, transform;
}

.scroll-react.from-left {
  transform: translateX(-44px);
}

.scroll-react.from-right {
  transform: translateX(44px);
}

.scroll-react.is-visible {
  opacity: 1;
  transform: translateX(0);
}

.t13-bg {
  position: fixed;
  inset: 0;
  /* masukan path gambar baru disini: background halaman setelah klik Open Invitation */
  background-image:
    linear-gradient(rgba(255, 252, 246, 0.60), rgba(255, 252, 246, 0.60)),
    url("./bunga.jpeg");
  background-size: cover, cover;
  background-position: center, center;
  background-repeat: no-repeat, no-repeat;
  background-blend-mode: normal, normal;
  opacity: 1;
  pointer-events: none;
  z-index: 0;
}

.t13-container {
  position: relative;
  z-index: 1;
  max-width: 1100px;
  margin: 0 auto;
  padding: 24px 16px 80px;
}

.t13-section {
  margin-top: 28px;
  position: relative;
  z-index: 1;
}

.t13-grid {
  display: grid;
  gap: 24px;
}

@media (min-width: 900px) {
