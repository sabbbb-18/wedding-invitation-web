  }
}

/* ========== LEAVES (floating elements) ========== */
.leaves-wrap {
  position: absolute;
  inset: 0;
  z-index: 3;
  pointer-events: none
}

.leaf {
  position: absolute;
  width: 40px;
  height: 18px;
  background: linear-gradient(90deg, rgba(170, 220, 170, 0.28), rgba(220, 245, 220, 0.08));
  border-radius: 10px;
  filter: blur(0.6px);
  opacity: 0.28;
  transform-origin: center;
  animation: leafFloat 9s linear infinite
}

.leaf.l1 {
  left: 6%;
  top: 30%;
  animation-delay: 0.2s
}

.leaf.l2 {
  left: 18%;
  top: 52%;
  animation-delay: 1.2s
}

.leaf.l3 {
  right: 12%;
  top: 22%;
  animation-delay: 2.1s
}

.leaf.l4 {
  left: 42%;
  top: 12%;
  animation-delay: 3.4s
}

.leaf.l5 {
  right: 28%;
  bottom: 22%;
  animation-delay: 2.7s
}

.leaf.l6 {
  left: 62%;
  bottom: 18%;
  animation-delay: 4.1s
}

.leaf.l7 {
  left: 30%;
  bottom: 6%;
  animation-delay: 1.8s
}

.leaf.l8 {
  right: 6%;
  top: 60%;
  animation-delay: 2.4s
}

@keyframes leafFloat {
  0% {
    transform: translateY(0) rotate(0)
  }

  50% {
    transform: translateY(-28px) rotate(10deg)
  }

  100% {
    transform: translateY(0) rotate(0)
  }
}

/* ========== RIBBON CURVE ========== */
.ribbon {
  z-index: 1;
  opacity: 0.95;
  filter: blur(6px)
}

/* ========== SNOW / PARTICLES ========== */
.particles-wrap {
  position: absolute;
  inset: 0;
  z-index: 4;
  pointer-events: none
}

.particle {
  position: absolute;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  filter: blur(1px);
  opacity: 0.16;
  animation: fall 10s linear infinite
}

@keyframes fall {
  0% {
    transform: translateY(-10vh)
  }

  100% {
    transform: translateY(110vh)
  }
}

/* some variety */
.particle.p1 {
  left: 3%;
  animation-delay: 0s;
  animation-duration: 12s
}

.particle.p2 {
  left: 8%;
  animation-delay: 1s;
  animation-duration: 9s
}

/* ... p3..p30 styles kept from earlier pattern (omitted here to keep snippet reasonable). */

/* ========== GOLD DUST EDGES ========== */
.gold-dust {
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 6;
  background-image: radial-gradient(circle at top left, rgba(255, 220, 160, 0.08), rgba(255, 255, 255, 0)), radial-gradient(circle at bottom right, rgba(255, 220, 160, 0.04), rgba(255, 255, 255, 0));
  mix-blend-mode: screen;
  opacity: 0.95
}

/* ========== SLIDE IN/OUT ========== */
.slide-in {
  opacity: 0;
  transform: translateY(18px) scale(0.995);
  animation: slideIn 0.38s cubic-bezier(.2, .9, .3, 1) forwards
}

.slide-out {
  opacity: 1;
  transform: translateY(0);
  animation: slideOut 0.32s cubic-bezier(.4, 0, .3, 1) forwards
}

@keyframes slideIn {
  to {
    opacity: 1;
    transform: translateY(0) scale(1)
  }
}

@keyframes slideOut {
  to {
    opacity: 0;
    transform: translateY(18px) scale(0.995)
  }
}

/* ========== FADE-UP reveal (existing) ========== */
.fade-up {
  opacity: 0;
  transform: translateY(24px);
  transition: all 0.7s ease-out
}

.fade-up.show {
  opacity: 1;
  transform: translateY(0)
}

/* ========== PHOTO FRAME ========== */
.photo-frame {
  width: 240px;
  height: 240px;
  border-radius: 20px;
  padding: 10px;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
  box-shadow: 0 18px 60px rgba(0, 0, 0, 0.6);
  border: 1px solid rgba(255, 230, 180, 0.06);
  overflow: hidden;
  position: relative
}

.photo-frame.big {
  width: 320px;
  height: 320px
}

.photo-frame img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  border-radius: 14px
}

.photo-floral-top {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 44px;
  height: 44px;
  background: radial-gradient(circle, rgba(255, 230, 190, 0.18), transparent);
  border-radius: 10px;
  opacity: 0.95
}

/* ========== GOLD DIVIDER ========== */
.gold-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  color: rgba(255, 230, 180, 0.98)
}

.gold-divider .line {
  height: 1px;
  width: 28%;
  background: linear-gradient(90deg, transparent, rgba(255, 230, 180, 0.18), transparent);
  display: inline-block
}

.gold-divider .ornament {
  font-size: 16px;
  color: rgba(255, 230, 180, 0.98);
  opacity: 0.98
}

/* ========== ELEGANT SECTION DIVIDER ========== */
.section-divider {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 24px 0;
  width: 100%;
}

.section-divider .divider-line {
  flex: 1;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(183, 143, 74, 0.15) 20%,
    rgba(183, 143, 74, 0.4) 50%,
    rgba(183, 143, 74, 0.15) 80%,
    transparent 100%
  );
  box-shadow: 0 0 8px rgba(183, 143, 74, 0.1);
}

.section-divider .divider-ornament {
  width: 8px;
  height: 8px;
  background: linear-gradient(135deg, #b78f4a 0%, #d4af37 100%);
  transform: rotate(45deg);
  box-shadow: 0 0 12px rgba(183, 143, 74, 0.4), 0 2px 4px rgba(0, 0, 0, 0.2);
  animation: diamondGlow 3s ease-in-out infinite;
}

@keyframes diamondGlow {
  0%, 100% {
    box-shadow: 0 0 12px rgba(183, 143, 74, 0.4), 0 2px 4px rgba(0, 0, 0, 0.2);
    transform: rotate(45deg) scale(1);
  }
  50% {
    box-shadow: 0 0 20px rgba(183, 143, 74, 0.6), 0 2px 6px rgba(0, 0, 0, 0.3);
    transform: rotate(45deg) scale(1.1);
  }
}

/* Mobile specific divider styling */
@media (max-width: 768px) {
  .section-divider {
    padding: 16px 0;
  }
  
  .section-divider .divider-ornament {
    width: 6px;
    height: 6px;
  }
}

/* ========== COUNTER CHIP ========== */
.counter-chip {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
  padding: 10px 14px;
  border-radius: 10px;
  font-weight: 700;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.55);
  min-width: 56px;
  text-align: center
}

/* ========== HELPERS ========== */
.text-white\/90 {
  color: rgba(255, 255, 255, 0.9)
}

.text-white\/85 {
  color: rgba(255, 255, 255, 0.85)
}

.text-white\/60 {
  color: rgba(255, 255, 255, 0.6)
}

/* ========== RESPONSIVE TWEAKS ========== */
@media (max-width:1024px) {
  .photo-frame.big {
    width: 260px;
    height: 260px
  }

  .text-glow {
    font-size: 1.2rem
  }
}

@media (max-width:768px) {
  .photo-frame {
    width: 160px;
    height: 160px
  }

  .bokeh.b1,
  .bokeh.b2 {
    display: none
  }

  .sparkle.premium {
    display: none
  }

  .leaf {
    display: none
  }

  .ribbon {
    display: none
  }

  .particles-wrap {
    display: none
  }
}

/* ========== existing animations (kept) ========== */
@keyframes fade {
  from {
    opacity: 0
  }

  to {
    opacity: 1
  }
}

.animate-fade {
  animation: fade 0.4s ease-out forwards
}

/* ========== reduce motion preference ========== */
@media (prefers-reduced-motion: reduce) {

  .bokeh-wrap,
  .sparkles-wrap,
  .leaves-wrap,
  .particles-wrap,
  .ribbon {
    animation: none !important;
    transition: none !important;
  }

  .fade-up {
    transition: none;
    transform: none;
    opacity: 1;
  }
}

@media (max-width: 480px) {
  header img {
    object-fit: contain !important;
    background-color: #000;
  }
}

.hero-image {
  width: 100%;
  height: 55vh;
  /* RESPONSIVE FIX */
  object-fit: cover;
  /* BIAR GA MELEBAR ANEH */
  object-position: center;
  border-radius: 0 0 30px 30px;
  display: block;
}

#countdown {
  margin-top: 30px !important;
}

@media (max-width: 480px) {
  #countdown h2 {
    font-size: 1.3rem;
  }

  #countdown .grid {
    gap: 8px;
  }

  #countdown .grid div div {
    font-size: 1.3rem !important;
    padding: 8px 0;
  }
}

.counter-chip {
  min-width: 60px;
  padding: 10px 0;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(6px);
  border-radius: 14px;
  font-size: 1.4rem;
  text-align: center;
}

@media (max-width: 400px) {
  .counter-chip {
    min-width: 50px;
    font-size: 1.2rem;
  }
}

