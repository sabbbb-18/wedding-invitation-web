    font-size: 10px !important;
    letter-spacing: 0.03em !important;
  }

  .t13-intro-meta-top {
    top: clamp(-18px, 1.8svh, 10px) !important;
  }

  .t13-intro-center {
    top: clamp(212px, 32.8svh, 312px) !important;
    transform: translate(-50%, -50%) !important;
    display: grid !important;
    place-items: center !important;
    padding: 0 !important;
  }

  .t13-intro-side {
    display: block !important;
    position: absolute !important;
    top: clamp(212px, 32.8svh, 312px) !important;
    z-index: 2 !important;
    font-size: 8px !important;
    letter-spacing: 0.12em !important;
    opacity: 0.88 !important;
    white-space: nowrap !important;
  }

  .t13-intro-left {
    left: 8px !important;
    transform: translateY(-50%) rotate(-90deg) !important;
  }

  .t13-intro-right {
    right: 8px !important;
    transform: translateY(-50%) rotate(90deg) !important;
  }

  .t13-intro-names {
    font-size: clamp(24px, 8.6vw, 42px) !important;
    line-height: 1.1 !important;
    gap: 12px !important;
  }

  .t13-intro-names span {
    font-size: clamp(28px, 9.2vw, 44px) !important;
    line-height: 1 !important;
    margin: 0 !important;
  }

  .t13-intro-meta-mid {
    top: clamp(448px, 65svh, 568px) !important;
  }

  .t13-intro-bottom {
    bottom: calc(max(18px, env(safe-area-inset-bottom)) + 40px) !important;
    text-align: center !important;
  }

  .t13-intro-action {
    margin-top: 10px !important;
  }

  .t13-intro-subtitle {
    margin-top: 6px !important;
  }
}

@media (max-width: 640px) {
  /* Same composition logic for phones; raised significantly but still safe from top clipping */
  .t13-intro-meta-top { top: clamp(-20px, 1.4svh, 8px) !important; }
  .t13-intro-center { top: clamp(200px, 31.8svh, 294px) !important; }
  .t13-intro-side { top: clamp(200px, 31.8svh, 294px) !important; }
  .t13-intro-meta-mid { top: clamp(432px, 63.2svh, 540px) !important; }
  .t13-intro-bottom { bottom: calc(max(18px, env(safe-area-inset-bottom)) + 40px) !important; }
}
