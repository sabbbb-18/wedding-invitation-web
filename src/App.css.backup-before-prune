.intro-ornate-shell::after {
  content: "";
  position: absolute;
  top: -18px;
  left: 50%;
  transform: translateX(-50%);
  width: 120px;
  height: 42px;
  border-radius: 999px;
  background: linear-gradient(135deg, #7d9c50 0%, #5d7f35 100%);
