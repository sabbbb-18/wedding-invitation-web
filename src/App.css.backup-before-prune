}

.hero-major .orb-b {
  width: 220px;
  height: 220px;
  right: -80px;
  bottom: -90px;
  background: radial-gradient(circle, rgba(216, 135, 41, 0.25) 0%, rgba(216, 135, 41, 0) 72%);
}

.hero-major .hero-tag {
